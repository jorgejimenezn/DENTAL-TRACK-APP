# URL privada del backend (red interna de Railway). El backend debe tener PORT=8000
BACKEND_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:8000
# La misma clave que tiene el servicio backend
INTERNAL_KEY=genera-una-clave-larga-y-aleatoria
# Secreto para firmar los tokens JWT
JWT_SECRET=genera-otro-secreto-largo
JWT_HORAS=10
# URL pública del frontend (para CORS)
CORS_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
